Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Social zone map
      Enabled: true
      Topic:
        Value: /social_zone_map
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color Scheme: costmap
      Alpha: 0.8
      Draw Behind: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 40; 40; 40
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Predicted person cloud
      Enabled: true
      Topic:
        Value: /predicted_person_cloud
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 220; 40; 40
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 25; 90; 200
      Line Style: Billboards
      Line Width: 0.04
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Robot (ground truth)
      Enabled: true
      Topic:
        Value: /sim_ground_truth_pose
      Keep: 1
      Shape:
        Value: Arrow
        Color: 0; 160; 70
        Shaft Length: 0.5
        Shaft Radius: 0.05
        Head Length: 0.2
        Head Radius: 0.12
      Value: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 90
      X: 2.7
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
  Hide Left Dock: false
